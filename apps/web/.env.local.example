# The app builds and runs with nothing set: most features fall back to a blank adapter.
# Every variable is declared and validated in a typed schema; see .docs/how-to/add-an-environment-variable.md.
# Empty values count as unset. Values that are set must be well formed or the build fails.

# Database (required once an authentication secret is set). A postgres:// URL.
DATABASE_URL=

# Authentication (Better Auth)
BETTER_AUTH_SECRET=
# A URL. Defaults to https://$VERCEL_URL on Vercel (VERCEL_URL is set by Vercel)
BETTER_AUTH_URL=

# Email: Resend takes priority over Mailgun when both are set.
RESEND_API_KEY=
RESEND_EMAIL_FROM=
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
# Defaults to postmaster@$MAILGUN_DOMAIN
MAILGUN_EMAIL_FROM=

# Payment
STRIPE_SECRET_KEY=

# Notifications (a URL)
SLACK_WEBHOOK_URL=

# A/B tests (flags fall back to their default value when unset)
NEXT_PUBLIC_POSTHOG_KEY=
# A URL, e.g. https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=
STATSIG_SERVER_API_KEY=
# Vercel flags SDK key
FLAGS=

# Analytics (scripts only load in production builds)
NEXT_PUBLIC_CONTENTSQUARE_ID=
# Numeric site id
NEXT_PUBLIC_HOTJAR_ID=
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=

# Telemetry (OpenTelemetry service name)
TELEMETRY_PROJECT=

