{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@ship-it/typescript-config",
  "compilerOptions": {
    "types": ["vitest/globals"],
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "vitest.config.ts",
    "vitest.setup.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
