{
  "name": "ship-it",
  "version": "1.0.0",
  "description": "The ultimate boilerplate for modern web projects",
  "workspaces": [
    "apps/*",
    "config/*",
    "domain/*",
    "infrastructure/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "lefthook install",
    "commitlint": "commitlint --from=HEAD~1 --config ./.config/commitlint.config.ts",
    "dev": "turbo dev",
    "web": "turbo dev --filter=@ship-it/web",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "check-adr-numbers": "bun .config/scripts/check-adr-numbers.ts",
    "check-auth-schema": "bun run --cwd infrastructure/adapters check-auth-schema",
    "check-features": "features check apps/web/src",
    "check-spec-numbers": "bun .config/scripts/check-spec-numbers.ts",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "lint:boundaries": "depcruise --config .config/dependency-cruiser.cjs --output-type err-long apps domain infrastructure",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "test": "turbo test",
    "test:ci": "turbo test:ci",
    "knip": "knip"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@commitlint/types": "^21.2.3",
    "@swc/core": "1.16.22",
    "dependency-cruiser": "18.7.2",
    "features-cli": "0.15.0",
    "knip": "6.44.2",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.73.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2006",
    "turbo": "2.11.7"
  },
  "overrides": {
    "@opentelemetry/api": "1.9.1",
    "next": "16.4.5",
    "zod": "4.6.7"
  },
  "packageManager": "bun@1.4.3"
}
